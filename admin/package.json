    "gen:api": "openapi-typescript ../shared/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@mantine/charts": "7.17.8",
    "@mantine/core": "7.17.8",
    "@mantine/dates": "7.17.8",
    "@mantine/form": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "@mantine/modals": "7.17.8",
    "@mantine/notifications": "7.17.8",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.3",
    "dayjs": "1.11.23",
    "leaflet": "1.9.4",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
