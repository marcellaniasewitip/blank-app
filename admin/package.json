{
  "name": "@cooper-waters/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cooper Waters admin dashboard",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
