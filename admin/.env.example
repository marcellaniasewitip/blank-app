# Backend origin (no trailing slash). REST is served under /api/v1, Socket.IO under /realtime.
VITE_API_BASE_URL=http://localhost:3100
# Map tiles (map provider is still an open decision; swap here without code changes).
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
